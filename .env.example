# Client (Expo) build-time configuration — MFP-07.
#
# WARNING: every EXPO_PUBLIC_* value is inlined into the app bundle and is
# world-readable. NEVER put a secret (signing key, DSN, credentials) here.
#
# Copy to `.env` for local development (`.env` is gitignored).

# development | test | staging | preview | production
EXPO_PUBLIC_ENVIRONMENT=development

# Game server URL. In production/staging/preview builds this is REQUIRED and
# must not be localhost. In development it defaults to http://localhost:3001.
EXPO_PUBLIC_GAME_SERVER_URL=http://localhost:3001

EXPO_PUBLIC_RELEASE_VERSION=1.0.0

# Optional public crash-reporting DSN (client). Safe no-op when unset. This is a
# client/public provider key — not a server secret.
EXPO_PUBLIC_ERROR_REPORTING_DSN=

# Native build identifiers — supply via EAS secrets / protected build env in
# CI, not by editing tracked source. Examples only:
IOS_BUNDLE_IDENTIFIER=com.example.helloworldmobile
ANDROID_PACKAGE=com.example.helloworldmobile
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
