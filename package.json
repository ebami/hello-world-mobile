{
  "name": "hello-world-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:client": "jest",
    "test:server": "npm test -w hello-world-mobile-server -- --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:core": "npm run build -w @hello-world/game-core",
    "build:server": "npm run build -w hello-world-mobile-server",
    "build:web": "expo export --platform web",
    "dev:server": "npm run build:core && npm run dev -w hello-world-mobile-server",
    "validate:env": "npm run build:core && npm run validate:env -w hello-world-mobile-server",
    "verify": "npm run build:core && npm run typecheck && npm run build:server && npm run test:server && npm run test:client && npm run build:web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.32",
    "expo-audio": "~1.1.1",
    "expo-av": "^16.0.8",
    "expo-haptics": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.3",
    "text-encoding": "^0.7.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "^54.0.10",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.16",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "ws": "^8.18.0"
  },
  "private": true
}
