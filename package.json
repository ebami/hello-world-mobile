{
  "name": "hello-world-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:client": "jest",
    "test:server": "npm test -w hello-world-mobile-server -- --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:core": "npm run build -w @hello-world/game-core",
    "build:server": "npm run build -w hello-world-mobile-server",
    "build:web": "expo export --platform web",
    "dev:server": "npm run build:core && npm run dev -w hello-world-mobile-server",
    "validate:env": "npm run build:core && npm run validate:env -w hello-world-mobile-server",
    "verify": "npm run build:core && npm run typecheck && npm run build:server && npm run test:server && npm run test:client && npm run build:web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "^57.0.18",
    "expo-asset": "~57.0.5",
    "expo-audio": "~57.0.4",
    "expo-dev-client": "~57.0.16",
    "expo-haptics": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.19",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.12.1",
    "socket.io-client": "^4.8.3",
    "text-encoding": "^0.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "^57.0.3",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
