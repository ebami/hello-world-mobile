# Server configuration — MFP-07 (see server/src/config.ts).
#
# Secrets belong ONLY here / in the server's runtime environment — never in an
# EXPO_PUBLIC_* variable or the client bundle. Copy to `server/.env` for local
# development (`server/.env` is gitignored).

# development | test | staging | production
NODE_ENV=development
PORT=3001

# Comma-separated CORS allow-list. Omit to allow all origins (development only).
CORS_ORIGINS=https://your-app.example.com

# error | warn | info | debug
LOG_LEVEL=info

# Room lifecycle / abuse-control limits (consumed by later stories).
ROOM_TTL_SECONDS=3600
DISCONNECT_GRACE_SECONDS=30
MAX_ROOMS=1000
MAX_CONNECTIONS_PER_IP=20
MAX_EVENTS_PER_MINUTE=240

# REQUIRED in production. Use a long, random value. Never commit the real key.
SESSION_SIGNING_KEY=replace-with-a-long-random-secret

# Optional error-reporting DSN (secret).
ERROR_REPORTING_DSN=

RELEASE_VERSION=1.0.0
